# The public demo reads only sanitized example files.
PERSONAL_AI_SOURCE_DIR=./raw-data.example/gemini
PERSONAL_AI_DATA_DIR=./data
PERSONAL_AI_USER_ID=local

# For private use, copy this file to .env.local and point to your own folder.
# PERSONAL_AI_SOURCE_DIR=../原始数据

# 可选：OpenAI-compatible 模型网关。未配置时使用本地证据答案，不上传记忆。
# MODEL_GATEWAY_BASE_URL=https://your-provider.example/v1
# MODEL_GATEWAY_API_KEY=replace-me
# MODEL_GATEWAY_MODEL=your-model-name
# MODEL_GATEWAY_PROVIDER=your-provider
# MODEL_GATEWAY_TIMEOUT_MS=30000
# MODEL_GATEWAY_MAX_RETRIES=1
